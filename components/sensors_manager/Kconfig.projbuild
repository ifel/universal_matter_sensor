menu "Sensors Configuration"

    config SENSORS_I2C_PORT
        int "I2C Port Number"
        range 0 1
        default 0
        help
            I2C port number used to communicate with I2C sensors.

    config SENSORS_I2C_SDA_GPIO
        int "I2C SDA GPIO Number"
        default 22
        help
            GPIO pin for I2C SDA line (GPIO 22 corresponds to pin D4 on Seeed Studio XIAO ESP32C6).

    config SENSORS_I2C_SCL_GPIO
        int "I2C SCL GPIO Number"
        default 23
        help
            GPIO pin for I2C SCL line (GPIO 23 corresponds to pin D5 on Seeed Studio XIAO ESP32C6).

    choice BMP280_I2C_ADDRESS_CHOICE
        prompt "BMP280 / BME280 I2C Address"
        default BMP280_I2C_ADDRESS_0X77
        help
            Select the I2C address of the BMP280/BME280 sensor.
            Adafruit BME280/BMP280 modules default to 0x77 (SDO pulled high).
            Generic modules with SDO connected to GND use 0x76.

        config BMP280_I2C_ADDRESS_0X77
            bool "0x77 (SDO high / Adafruit default)"
        config BMP280_I2C_ADDRESS_0X76
            bool "0x76 (SDO connected to GND)"
    endchoice

    config BMP280_I2C_ADDRESS
        hex
        default 0x77 if BMP280_I2C_ADDRESS_0X77
        default 0x76 if BMP280_I2C_ADDRESS_0X76

    choice BMP581_I2C_ADDRESS_CHOICE
        prompt "BMP581 / BMP585 I2C Address"
        default BMP581_I2C_ADDRESS_0X47
        help
            Select the I2C address of the BMP581 / BMP585 sensor.
            Adafruit and SparkFun BMP581 modules default to 0x47 (SDO pulled high).
            Modules with SDO connected to GND use 0x46.

        config BMP581_I2C_ADDRESS_0X47
            bool "0x47 (SDO high / module default)"
        config BMP581_I2C_ADDRESS_0X46
            bool "0x46 (SDO connected to GND)"
    endchoice

    config BMP581_I2C_ADDRESS
        hex
        default 0x47 if BMP581_I2C_ADDRESS_0X47
        default 0x46 if BMP581_I2C_ADDRESS_0X46

    choice ENS160_I2C_ADDRESS_CHOICE
        prompt "ENS160 I2C Address"
        default ENS160_I2C_ADDRESS_0X53
        help
            Select the I2C address of the ENS160 sensor.
            Most ENS160 modules default to 0x53 (ADDR pulled high).
            Modules with ADDR connected to GND use 0x52.

        config ENS160_I2C_ADDRESS_0X53
            bool "0x53 (ADDR high / module default)"
        config ENS160_I2C_ADDRESS_0X52
            bool "0x52 (ADDR connected to GND)"
    endchoice

    config ENS160_I2C_ADDRESS
        hex
        default 0x53 if ENS160_I2C_ADDRESS_0X53
        default 0x52 if ENS160_I2C_ADDRESS_0X52

    config VL53L1X_FULL_DISTANCE_MM
        int "VL53L1X distance when full (mm)"
        range 0 4000
        default 30
        help
            Distance from the VL53L1X to the top of the consumable (e.g. a salt block) when it is
            full: reported as 100% remaining. The sensor's specified minimum range is 40 mm;
            closer readings are less reliable.

    config VL53L1X_LEVEL_HEIGHT_MM
        int "VL53L1X level height, full to empty (mm)"
        range 1 4000
        default 290
        help
            How much farther the target is when empty (e.g. the salt block height): the distance
            FULL_DISTANCE + LEVEL_HEIGHT is reported as 0% remaining.

endmenu
