CONFIG_COMPILER_OPTIMIZATION_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_TASK_FUNCTION_WRAPPER=n
CONFIG_OPTIMIZATION_LEVEL_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_LEVEL_DEBUG=n
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=n
# Flash size: no debug shell, Matter logs errors only (compiled out), no NimBLE logs,
# silent asserts, no mbedTLS error strings. Saves ~184 KB of the 1.875 MB app slot.
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_MBEDTLS_ERROR_STRINGS=n
